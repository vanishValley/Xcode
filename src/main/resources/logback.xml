<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!--
      Main 在初始化任何 Logger 前设置 xcode.log.dir。
      环境变量用于测试或部署覆盖；最后一层全局目录仅作为非 Main 入口的兜底。
    -->
    <property name="LOG_DIR"
              value="${xcode.log.dir:-${XCODE_LOG_DIR:-${user.home}/.xcode/logs}}" />

    <!-- 文件按日期和大小双重滚动，避免长时间工具任务撑满磁盘。 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/xcode.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/archive/xcode.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level trace_id=%X{trace_id:--} span_id=%X{span_id:--} task_id=%X{task_id:--} thread=%thread logger=%logger{36} - %msg %kvp%n</pattern>
        </encoder>
    </appender>

    <root level="${xcode.log.level:-${XCODE_LOG_LEVEL:-INFO}}">
        <appender-ref ref="FILE" />
    </root>
</configuration>
