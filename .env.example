DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-chat

# 危险工具默认需要人工确认；设为 false 可关闭（也可运行时 /hitl off）。
HITL_ENABLED=true

# 日常使用 INFO；排查单条链路时临时改成 DEBUG 并重启。
XCODE_LOG_LEVEL=INFO

# Windows 命令输出乱码时可显式设置，例如 GBK 或 UTF-8；默认跟随系统编码。
# XCODE_COMMAND_CHARSET=GBK

# 腾讯云联网搜索 API：web_search 需要；web_fetch 不需要 API Key。
WSA_API_KEY=your_tencent_wsa_api_key_here

# Chrome DevTools MCP：需要 Node.js、npx 和 Chrome，不需要 API Key。
CHROME_MCP_ENABLED=true
CHROME_MCP_HEADLESS=true
CHROME_MCP_PACKAGE=chrome-devtools-mcp@1.6.0

# DeepWiki 远程 MCP：通过 Streamable HTTP 访问公开 GitHub 仓库，无需 API Key。
DEEPWIKI_MCP_ENABLED=true
DEEPWIKI_MCP_URL=https://mcp.deepwiki.com/mcp
